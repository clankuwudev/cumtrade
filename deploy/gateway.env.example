# /etc/clank/gateway.env: root-owned, mode 0600, read by systemd for
# clank-gateway.service. See docs/deploy.md and x18-gateway-service.md (Q3).
#
# Nothing else belongs here. The gateway refuses to start if KEYSTORE_PATH,
# WALLET_PASSPHRASE, WALLET_HOT or PRIVATE_KEY is set, and refuses
# MODERATION=off or a SITE_ORIGIN other than https://clankuwu.com with a
# public host, or the free tier on without its budget and its own key.

# The VM's own APIMart key, made at APIMart for this server (Q4), never the
# development key. It lives only in this file and the gateway's memory. If it
# leaks: rotate it at APIMart, edit this file, restart clank-gateway.
APIMART_API_KEY=

# The credit ledger (SQLite), under the only directory the service may write.
# That directory is 0700 clank-gw, so the key CLI runs as clank-gw too.
LEDGER_DB=/var/lib/clank-gateway/ledger.sqlite

# The gateway's host, a bare name with no scheme. Every Host is held to it.
GATEWAY_PUBLIC_HOST=api.clankuwu.com

# Caddy writes X-Forwarded-For. The client, for the per-address limits, is its
# rightmost entry.
TRUST_PROXY=1

# Sign-in, and the free tier's check of a new address (X19 F7), read chain
# 4663 here: the hosted RPC key or one of its own (P8). Leave the line out
# entirely to use the chain's public RPC.
RPC_URL=

# The free tier (x19-free-tier.md; docs/deploy.md G11): signed-in visitors
# chat with one cheap model for free, a little each day. off, preview or on.
# preview (stage C, c-playground.md C-D7) lets only FREE_TIER_ALLOW's
# addresses chat, for a private test on the live site; on is everyone.
# Either needs the budget and its own key.
FREE_TIER=off
# Only with FREE_TIER=preview: the addresses that may chat, comma-separated.
# With FREE_TIER=on the gateway refuses to start while this is set.
FREE_TIER_ALLOW=
# The most all free calls together may cost in a UTC day, at cost, released
# 1/24 an hour (F4).
FREE_DAILY_BUDGET_USD=5
# The free tier's own APIMart account's key (F11), never a copy of
# APIMART_API_KEY: a ban earned by anonymous visitors then stops only the free
# tier. Or "shared": run it on the paid account on purpose (the user's choice,
# 2026-09-24), where a ban or an empty balance stops paid calls too.
FREE_APIMART_API_KEY=
# Defaults, set only to change them:
#   FREE_MODEL=gpt-4.1-nano          a chat model whose output cap is trusted
#   FREE_ALLOWANCE_USD=0.01          per address, per UTC day, at cost
#   FREE_MIN_BALANCE_ETH=0.00001     what a new wallet that has sent nothing must hold (F7)

# Live model status (stage C, c-playground.md C-D10; docs/deploy.md G12).
# Passive from real calls always. With STATUS_PROBE_ADDRESS set, a one-token
# probe per model every STATUS_PROBE_MINUTES, charged to that address's test:
# account (fund it: npm run gateway:key -- credit-test <address> 30 probes),
# never more than STATUS_DAILY_BUDGET_USD a day.
STATUS_PROBE_ADDRESS=
#   STATUS_PROBE_MINUTES=30
#   STATUS_DAILY_BUDGET_USD=1

# Pictures (X15, docs/specs/x15-pictures.md): POST /v1/images/generations for
# keys, on the same APIMart key and ledger. "on" needs moderation: every
# picture is checked with its prompt before it is shown. Off by default.
PICTURES=off

# Free pictures (X15b): the Playground's picture mode, on the free tier's
# sign-in, gate and key. Needs FREE_TIER on or preview; off unless on.
FREE_IMAGE=off
#   FREE_IMAGE_DAILY_BUDGET_USD=2    needed when on: all free pictures in a day
#   FREE_IMAGE_PER_DAY=2             per wallet
#   FREE_IMAGE_MODEL=gpt-image-2     made at its first tier (1K)
