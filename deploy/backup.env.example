# /etc/clank/backup.env: root-owned, mode 0600, read by systemd for
# clank-gateway-backup.service and clank-gateway-predeploy-backup.service.
# See docs/deploy.md G9 and x24-backups-monitoring.md (B3, B4, B8).

# The operator's age PUBLIC key (age1…). The private key is never on this
# machine: it is in the operator's password manager, and on paper (Q5).
AGE_RECIPIENT=

# The Backblaze B2 bucket, through its S3-compatible API (Q1). The key is an
# application key restricted to this bucket that can write files and NOT delete
# them (no deleteFiles), with object lock on the bucket. The endpoint and region
# are on the bucket's page, e.g. https://s3.us-west-004.backblazeb2.com and
# us-west-004.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# The backup's heartbeat at healthchecks.io (Q3): its ping URL, with no
# trailing slash. Period 1 day, grace 2 hours, so a missed night alerts at 26.
HC_BACKUP_URL=
