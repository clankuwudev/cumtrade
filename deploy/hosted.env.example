# /etc/clank/hosted.env: root-owned, mode 0600, read by systemd for
# clank-hosted.service. See docs/deploy.md.
#
# Nothing here may name a wallet. Hosted refuses to start if KEYSTORE_PATH,
# WALLET_PASSPHRASE, WALLET_HOT or PRIVATE_KEY is set.

# The site's one origin. Every Host and every POST's Origin is held to it.
PUBLIC_ORIGIN=https://staging.example.net

# Hosted's own RPC key, never self mode's, with a budget alert (P8, Q5).
RPC_URL=
WS_URL=

# Log scans (history, holders, ledgers): the site's Alchemy HTTPS URL, on
# Pay-As-You-Go. The free tier answers eth_getLogs over 10 blocks only. The
# chain's public node stands behind it on a refusal or an outage (D1.0).
LOGS_RPC_URL=

# The chain index (D1): SQLite, under the only directory the service may write.
INDEX_DB=/var/lib/clank/index.sqlite

# Caddy writes X-Forwarded-For. The client, for rate limits, is its rightmost entry.
TRUST_PROXY=1

# The only path the service can write (ReadWritePaths).
HISTORY_FILE=/var/lib/clank/history.json

# Token logos, shrunk, kept across restarts (P1f). Without it a deploy refetches
# the whole board from the public IPFS gateways at once, and they answer 429.
LOGO_DIR=/var/lib/clank/logos

WEB_PORT=8787
WEB_BACKFILL=40
# The most tokens the board holds. Past it the oldest unbonded launch drops
# off, so this bounds memory and the sweep's RPC. About 12 days of launches.
WEB_BOARD_MAX=200

# The leaderboard's exclusion list (x29-leaderboard.md, L1 and L7): the
# operator's own wallets and anyone who asked to be taken off, as addresses
# separated by commas. They are left out of /api/leaders and the Traders
# page, and nothing says which. The list is never published: its values live
# only here, never in git. Read at start, so a change needs a restart.
LEADERS_EXCLUDE=
