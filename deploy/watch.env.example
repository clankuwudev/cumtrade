# /etc/clank/watch.env: root-owned, mode 0600, read by systemd for
# clank-watch.service, after /etc/clank/gateway.env (which gives it
# APIMART_API_KEY, LEDGER_DB and GATEWAY_PUBLIC_HOST). See docs/deploy.md G9
# and x24-backups-monitoring.md (B8, B9).

# The watch's check at healthchecks.io (Q3), alerting by email (Q2): period
# 1 hour, grace 1 hour. It goes down, with the alarm in the email, when watch
# finds something or cannot run, and up when all is clear (clank-watch-run).
HC_WATCH_URL=

# Optional, not used for now (the user dropped Telegram, 2026-09-24): a bot
# from @BotFather and the operator's chat id, and watch sends every alarm there
# too, with a daily reminder while one stands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert when APIMart's balance is under this many dollars (Q4).
WATCH_APIMART_FLOOR_USD=5

# With the free tier on (X19 F10): alert when its own APIMart account is under
# this many dollars. It reads FREE_* and FREE_APIMART_API_KEY from gateway.env.
WATCH_FREE_FLOOR_USD=2

# Drift needs APIMart's balance to move only with the VM's calls. Leave it off
# until the VM has its own APIMart account (Q4); then remove this line.
WATCH_DRIFT=off
