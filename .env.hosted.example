# Hosted mode, run locally: copy to .env.hosted (never committed) and
#   npm run start:hosted
#
# Hosted reads ONLY this file and its own environment, never .env. The .env
# next to it is self mode's: wallet settings and the operator's RPC key, which
# a public process must not share (public-release P8). If KEYSTORE_PATH,
# WALLET_PASSPHRASE, WALLET_HOT or PRIVATE_KEY is set, hosted refuses to start.
#
# On a server the same variables live in /etc/clank/hosted.env (docs/deploy.md).

# The one origin the site is served from. Required: every Host must name it and
# every POST's Origin must equal it. Locally, the address you open in the browser.
PUBLIC_ORIGIN=http://localhost:8790
WEB_PORT=8790

# A separate RPC key from self mode's, with its own budget alert (P8, Q5).
# Blank uses the chain's public node, which is rate-limited.
RPC_URL=
WS_URL=

# Log scans (history, holders, ledgers): an Alchemy HTTPS URL on Pay-As-You-Go
# (the free tier answers eth_getLogs over 10 blocks only). Blank sends them to
# the chain's public node, which is also the fallback when this is set.
LOGS_RPC_URL=

# The chain index (D1): its own file, never self mode's data/index.sqlite.
INDEX_DB=data/hosted-index.sqlite
# How often the follower reads new blocks, and where its steady tail goes
# (public: the chain's node first; alchemy: LOGS_RPC_URL first).
#FOLLOW_MS=2000
#TAIL_RPC=public
# How often the index is checked against the chain (20 tokens a time, D1.5).
#INDEX_DRIFT_MS=600000

# 1 only behind your own proxy, which writes X-Forwarded-For (H1's Caddy does).
TRUST_PROXY=

# Where chart history is written. On a server: /var/lib/clank/history.json.
HISTORY_FILE=data/hosted-history.json

# How many past launches to load on boot.
WEB_BACKFILL=40
# The most tokens the board holds. Past it the oldest unbonded launch drops
# off, so this bounds memory and the sweep's RPC. About 12 days of launches.
WEB_BOARD_MAX=200
